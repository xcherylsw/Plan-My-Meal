rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's private pointer to the household they belong to.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared recipe library: anyone may read it; only the admin may change it.
    // Admin = the Google address that signs in to edit the library.
    match /library/{recipeId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'xcherylsw@gmail.com';
    }

    match /households/{hid} {
      // Knowing the household's code (it is the document ID) is what lets
      // someone look it up to join. The meal data lives in subcollections
      // below and is members-only.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if request.auth != null && (
        // a member updating who's in the household / their names
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']))
        // someone joining with the code: they may add themselves, nothing else
        // ...but only if the owner has put their Google email on the invite list
        || (!(request.auth.uid in resource.data.members)
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/households/$(hid)/invites/$(request.auth.token.email.lower()))
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']))
      );

      // Plans, kitchen, recipes: members only.
      match /chunks/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
      match /slices/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }

      // Invite list (one document per allowed email): members can see it,
      // only the household's owner can change it.
      match /invites/{email} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
        allow write: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/households/$(hid)).data.owner;
      }
    }
  }
}
